<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Periodic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surface</item> <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Periodic.AlertDialog</item>
    </style>
    <style name="ThemeOverlay.Periodic.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">?attr/colorSurface</item>

        <item name="colorSurfaceContainerHigh">?attr/colorSurface</item>

        <item name="buttonBarPositiveButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
    </style>

    <style name="AnalyticsLineChart">
        <item name="layers">line</item>
        <item name="showStartAxis">true</item>
        <item name="showBottomAxis">true</item>
        <item name="lineLayerStyle">@style/AnalyticsLineLayer</item>
    </style>

    <style name="AnalyticsColumnChart">
        <item name="layers">column</item>
        <item name="showStartAxis">true</item>
        <item name="showBottomAxis">true</item>
        <item name="columnLayerStyle">@style/AnalyticsColumnLayer</item>
    </style>

    <style name="AnalyticsCandlestickChart">
        <item name="layers">candlestick</item>
        <item name="showStartAxis">true</item>
        <item name="showBottomAxis">true</item>
        <item name="scrollEnabled">true</item>
        <item name="zoomEnabled">true</item>
    </style>

    <style name="AnalyticsCandlestickChartFit" parent="AnalyticsCandlestickChart">
        <item name="scrollEnabled">false</item>
        <item name="zoomEnabled">false</item>
    </style>

    <style name="AnalyticsLineLayer">
        <item name="line1Style">@style/AnalyticsTrendLine</item>
        <item name="pointSpacing">24dp</item>
    </style>

    <style name="AnalyticsTrendLine">
        <item name="android:color">?attr/colorPrimary</item>
        <item name="thickness">3dp</item>
        <item name="pointSize">6dp</item>
    </style>

    <style name="AnalyticsColumnLayer">
        <item name="column1Style">@style/AnalyticsAdherenceColumn</item>
        <item name="columnCollectionSpacing">20dp</item>
    </style>

    <style name="AnalyticsAdherenceColumn">
        <item name="android:color">?attr/colorTertiary</item>
    </style>

    <style name="AnalyticsLineChartFit" parent="AnalyticsLineChart">
        <item name="scrollEnabled">false</item>
        <item name="zoomEnabled">false</item>
        <item name="lineLayerStyle">@style/AnalyticsLineLayerFit</item>
    </style>

    <style name="AnalyticsColumnChartFit" parent="AnalyticsColumnChart">
        <item name="scrollEnabled">false</item>
        <item name="zoomEnabled">false</item>
        <item name="columnLayerStyle">@style/AnalyticsColumnLayerFit</item>
    </style>

    <style name="AnalyticsLineLayerFit">
        <item name="line1Style">@style/AnalyticsTrendLine</item>
        <item name="pointSpacing">8dp</item>
    </style>

    <style name="AnalyticsColumnLayerFit">
        <item name="column1Style">@style/AnalyticsAdherenceColumn</item>
        <item name="columnCollectionSpacing">8dp</item>
    </style>

    <style name="AnalyticsStackedColumnLayer" parent="AnalyticsColumnLayer">
        <item name="mergeMode">stacked</item>
        <item name="columnCollectionSpacing">8dp</item>
    </style>

    <style name="AnalyticsStackedColumnChart" parent="AnalyticsColumnChart">
        <item name="scrollEnabled">true</item>
        <item name="zoomEnabled">false</item>
        <item name="columnLayerStyle">@style/AnalyticsStackedColumnLayer</item>
    </style>
</resources>